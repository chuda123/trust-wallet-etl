# Copy to .env for local (non-Docker) runs.
# Docker Compose injects these via compose; do not commit real secrets.

HTTP_ADDR=:8080
POLL_INTERVAL=30s
FETCH_RESULTS=10
API_URL=https://randomuser.me/api/
API_TIMEOUT=15s

# Local: postgres on localhost. Compose overrides host to "postgres".
DATABASE_URL=postgres://etl:etl@localhost:5432/etl?sslmode=disable

DATA_DIR=./data
LOG_PATH=./logs/etl.log
SOURCE_NAME=randomuser
SCHEMA_VERSION=1.0.0
