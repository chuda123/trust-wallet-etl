# Binaries
/bin/
/etl
*.exe
*.test

# Runtime data (generated by the pipeline)
/data/raw/**
/data/processed/**
/data/dlq/**
/data/raw_data.json
/data/processed_data.json
/data/dlq.json
/logs/*.log

# Keep lake directory structure in git
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/dlq/.gitkeep
!/logs/.gitkeep

# Secrets and local env
.env
.env.local

# Go / editor
vendor/
.idea/
.vscode/
.DS_Store
*.swp
